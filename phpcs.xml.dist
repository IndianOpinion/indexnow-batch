<?xml version="1.0"?>
<ruleset name="indexnow-batch">
    <description>PSR-12 for the plugin and its tests.</description>
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>indexnow-batch.php</file>
    <file>uninstall.php</file>
    <exclude-pattern>tests/phpstan/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
    <!-- Entry points declare constants and register hooks by design. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>indexnow-batch.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
        <exclude-pattern>src/autoload.php</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <!-- WordPress and WP-CLI dictate these names: stub classes, wp-cli subcommands. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>src/Cli/*</exclude-pattern>
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration">
        <exclude-pattern>tests/stubs/*</exclude-pattern>
    </rule>
</ruleset>
